  "rules": {
    "hard": [
      {
        "id": "H01",
        "rule": "1.500 <= stadium.capacity <= 60.000 e capacidade múltipla de 100"
      },
      {
        "id": "H02",
        "rule": "0 <= estimatedHomeAttendance <= stadium.capacity"
      },
      {
        "id": "H03",
        "rule": "budgetTotal >= 0; salários + manutenção + transferências <= budgetTotal"
      },
      {
        "id": "H04",
        "rule": "visualIdentity usa cores do próprio clube para escudo, bandeira e estandarte"
      },
      {
        "id": "H05",
        "rule": "clubId persistente e independente de nome/tema"
      },
      {
        "id": "H06",
        "rule": "mesma seed + mesmo estado de travas + mesmas entradas => mesmos resultados"
      },
      {
        "id": "H07",
        "rule": "todo valor financeiro tem unidade e período; BRL/ano"
      },
      {
        "id": "H08",
        "rule": "alterações manuais nunca são sobrescritas silenciosamente"
      }
    ],
    "soft": [
      {
        "id": "S01",
        "rule": "ocupação média entre 35% e 90%",
        "penalty": 15
      },
      {
        "id": "S02",
        "rule": "símbolos, padrão e estilo com afinidade ao tema de origem",
        "penalty": 8
      },
      {
        "id": "S03",
        "rule": "padrão estético e atmosfera coerentes com perfil de torcida",
        "penalty": 5
      },
      {
        "id": "S04",
        "rule": "estádio preferencialmente na faixa temática, salvo legado, arrendamento ou investimento",
        "penalty": 7
      },
      {
        "id": "S05",
        "rule": "contraste cromático entre primária e secundária >= 2.5",
        "penalty": 12
      },
      {
        "id": "S06",
        "rule": "orçamento excepcionalmente alto por torcedor local requer justificativa de financiamento ou audiência digital",
        "penalty": 12
      },
      {
        "id": "S07",
        "rule": "estádio novo muito maior que demanda exige projeto financiado ou empréstimo/compartilhamento",
        "penalty": 8
      }
    ],
    "acceptanceScoreMin": 75,
    "maxRetries": 20,
    "manualOverridePolicy": "aviso + justificativa, não corrigir valor travado",
    "rareExceptionRateMax": 0.1
  },
  "financialModel": {
    "homeMatchesPerYear": 18,
    "attendanceTargetOccupancy": [
      0.52,
      0.84
    ],
    "annualMembershipFeeBRL": [
      150,
      450
    ],
    "digitalAnnualIncomePerFollowerBRL": [
      0.2,
      1.7
    ],
    "incomeFormula": "grossAnnual = attendance*18*netTicketPrice + round(localFans*memberConversion)*annualMemberFee + sponsorAnnual + digitalFollowers*digitalYield + committedAnnualBacking",
    "budgetsFormula": "operatingAnnual = round(grossAnnual*0.84 / 1000)*1000; salariesAnnual = round(operatingAnnual*0.58); stadiumOpsAnnual = round(operatingAnnual*0.28); transfersAnnual = operatingAnnual - salariesAnnual - stadiumOpsAnnual",
    "sponsorFormula": "sponsorAnnual = sponsorBaseByScale * originSponsorFactor * fundingSponsorFactor",
    "stadiumRule": "sem estádio definido: selecionar capacidade proporcional à demanda esperada, com occupancy alvo 52%-84%, ajustando a escala; estádio já criado/travado: gerar demanda e torcida coerentes com ele, sem alterá-lo",
    "fundingRule": "investidor, mecenato ou instituição permitem orçamento elevado com torcida pequena, exibindo fonte da receita; receita digital não cria público físico automático",
    "participationNote": "taxas representam demanda média em um jogo típico a partir da base local, não comparecimento de todo torcedor em todos os jogos",
    "sponsorBaseScaleRangesBRL": {
      "local": [
        150000,
        900000
      ],
      "municipal": [
        600000,
        2500000
      ],
      "regional": [
        1800000,
        8500000
      ],
      "nacional": [
        5500000,
        26000000
      ]
    },
    "notModeled": "endividamento, inflação, contratos individuais, direitos de TV e mercado de transferência — futuro módulo financeiro"
  },
