  "rules": [
    {
      "group": "design",
      "key": "idioma",
      "value": "pt-BR",
      "explanation": "Nomes e descrições em português; identificadores técnicos ASCII."
    },
    {
      "group": "geracao",
      "key": "modos",
      "value": "manual | aleatorio-total | hibrido | aleatorio-por-tema",
      "explanation": "Geração por tema também aceita campos travados."
    },
    {
      "group": "geracao",
      "key": "seed",
      "value": "string curta ou inteiro",
      "explanation": "Mesma seed + mesmo catálogo/versão + mesmos bloqueios = mesmo clube."
    },
    {
      "group": "geracao",
      "key": "tamanho nome",
      "value": "3–40 caracteres",
      "explanation": "Até 40; evitar repetição de FC/Clube."
    },
    {
      "group": "geracao",
      "key": "sigla",
      "value": "2–5 caracteres A-Z e 0-9",
      "explanation": "Derivar de palavras relevantes; resolver colisões."
    },
    {
      "group": "geracao",
      "key": "unicidade",
      "value": "clubName e clubId normalizados",
      "explanation": "Checar contra os criados e nomes reservados do banco existente."
    },
    {
      "group": "geracao",
      "key": "locks",
      "value": "campo por campo",
      "explanation": "Não sortear campos bloqueados; campos dependentes recalculados somente quando destravados."
    },
    {
      "group": "geracao",
      "key": "regeracao",
      "value": "sorteio independente por bloco",
      "explanation": "Identidade, cores, escudo, bandeira, estandarte, estádio."
    },
    {
      "group": "geracao",
      "key": "tentativas",
      "value": "máximo 20",
      "explanation": "Em caso de impossibilidade por bloqueios, oferecer correção manual; não ficar em loop."
    },
    {
      "group": "paleta",
      "key": "distancia minima",
      "value": "delta RGB >= 100",
      "explanation": "E contraste visual recomendado >= 3:1 entre cores dominantes."
    },
    {
      "group": "paleta",
      "key": "texto sobre fundo",
      "value": "contraste WCAG AA",
      "explanation": "Usar cor de texto automático; não usar cor secundária sobre fundo sem contraste."
    },
    {
      "group": "visual",
      "key": "escudo",
      "value": "SVG original com componentes geométricos",
      "explanation": "Não copiar logotipos de clubes reais; renderizar por shape, icon, cores e texto."
    },
    {
      "group": "visual",
      "key": "bandeira",
      "value": "proporção 3:2",
      "explanation": "Padrões e emblemas derivados da identidade escolhida."
    },
    {
      "group": "visual",
      "key": "estandarte",
      "value": "proporção 2:3",
      "explanation": "Formato vertical; nome/lema opcional; mesmo símbolo de referência."
    },
    {
      "group": "visual",
      "key": "estilos permitidos",
      "value": "enum do dicionario",
      "explanation": "Fallback padrão quando catálogo for ampliado."
    },
    {
      "group": "estadio",
      "key": "capacidade absoluta",
      "value": "1.500–60.000",
      "explanation": "Usar faixas sugeridas por tema, não uma trava rígida."
    },
    {
      "group": "estadio",
      "key": "capacidade arredondada",
      "value": "múltiplos de 100",
      "explanation": "Evitar números absurdamente aleatórios ou sem sentido."
    },
    {
      "group": "estadio",
      "key": "nome unico",
      "value": "por clube",
      "explanation": "Evitar nomes de estádios reais quando gerado automaticamente."
    },
    {
      "group": "estadio",
      "key": "efeito em partida",
      "value": "cosmético na primeira versão",
      "explanation": "Torcida e atmosfera só impactam jogabilidade em fase posterior com balanceamento."
    },
    {
      "group": "compatibilidade",
      "key": "identidade distinta de elenco",
      "value": "clubId != teamId existente",
      "explanation": "Criar clube sem apagar equipes/jogadores; integrar seleção de elenco depois."
    },
    {
      "group": "compatibilidade",
      "key": "versao do schema",
      "value": "1.0.0",
      "explanation": "Importar/exportar sem perda de campos; preservar campos desconhecidos."
    },
    {
      "group": "armazenamento",
      "key": "persistência",
      "value": "JSON versionado",
      "explanation": "Permitir reabrir e editar o clube salvo."
    },
    {
      "group": "interface",
      "key": "edição manual",
      "value": "sem ações irreversíveis",
      "explanation": "Prévia ao vivo, confirmar/cancelar, validação junto ao campo."
    },
    {
      "group": "interface",
      "key": "aleatoriedade coerente",
      "value": "tema define pesos",
      "explanation": "Nenhum tema exige determinada cor ou símbolo; são preferências."
    },
    {
      "group": "seguranca",
      "key": "entrada do usuário",
      "value": "escape + validação",
      "explanation": "Não inserir HTML do nome/lema diretamente em innerHTML ou SVG."
    },
    {
      "group": "acessibilidade",
      "key": "cores",
      "value": "não depender só de cor",
      "explanation": "Cores combinadas com padrões, ícones e rótulos."
    }
  ],
  "display": {
    "flagRatio": "3:2",
    "bannerRatio": "2:3",
    "crestFormat": "svg",
    "useOriginalSvgIcons": true
  },
  "integration": {
    "currentRosterShouldStayIntact": true,
    "playerPoolAttachment": "future-phase",
    "customClubsAreDistinctEntities": true
  }
